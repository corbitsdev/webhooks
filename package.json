{
  "name": "@corbits/webhooks",
  "version": "0.1.0",
  "description": "Receive signed webhooks (Slack, Standard Webhooks, bearer) and start a workflow run.",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "homepage": "https://github.com/corbitsdev/webhooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/webhooks.git"
  },
  "bugs": {
    "url": "https://github.com/corbitsdev/webhooks/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test ./src",
    "test:e2e": "bun test ./e2e"
  },
  "peerDependencies": {
    "@intx/crypto": "^0.4.0",
    "@intx/db": "^0.4.0",
    "@intx/hub-common": "^0.4.0",
    "@intx/hub-api": "^0.4.0",
    "@intx/mime": "^0.4.0",
    "@intx/types": "^0.4.0",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@intx/crypto": "0.4.0",
    "@intx/db": "0.4.0",
    "@intx/hub-api": "0.4.0",
    "@intx/hub-common": "0.4.0",
    "@intx/mime": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.9",
    "drizzle-orm": "0.45.3",
    "hono": "4.11.9",
    "typescript": "5.9.3"
  }
}
